+
+    @staticmethod
+    def _validate(state: object) -> None:
+        if not isinstance(state, dict) or set(state) != {"revision", "tasks"}:
+            raise StoreError("malformed task store: expected revision and tasks")
+        revision = state["revision"]
+        tasks = state["tasks"]
+        if not isinstance(revision, int) or isinstance(revision, bool) or revision < 0:
+            raise StoreError("malformed task store: revision must be non-negative")
+        if not isinstance(tasks, list):
+            raise StoreError("malformed task store: tasks must be a list")
+        identifiers = set()
+        for task in tasks:
+            if not isinstance(task, dict) or set(task) != {"id", "title", "completed"}:
+                raise StoreError("malformed task store: invalid task")
+            task_id = task["id"]
+            if (
+                not isinstance(task_id, int)
+                or isinstance(task_id, bool)
+                or task_id <= 0
+                or task_id in identifiers
+                or not isinstance(task["title"], str)
+                or not task["title"]
+                or not isinstance(task["completed"], bool)
+            ):
+                raise StoreError("malformed task store: invalid task")
+            identifiers.add(task_id)
