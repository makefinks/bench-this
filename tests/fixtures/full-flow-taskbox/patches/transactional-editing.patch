diff --git a/taskbox/transaction.py b/taskbox/transaction.py
new file mode 100644
index 0000000..ffed6b9
--- /dev/null
+++ b/taskbox/transaction.py
@@ -0,0 +1,100 @@
+"""Durable transaction snapshots for Taskbox."""
+
+import json
+from pathlib import Path
+
+from .store import (
+    Store,
+    StoreError,
+    add_task,
+    complete_task,
+    remove_task,
+    write_json_atomic,
+)
+
+
+class Transaction:
+    """Stage task edits against one committed store revision."""
+
+    def __init__(self, store: Store):
+        self.store = store
+        self.path = Path(f"{store.path}.transaction")
+
+    def begin(self) -> dict:
+        if self.path.exists():
+            raise StoreError("a transaction is already open")
+        committed = self.store.load()
+        transaction = {
+            "base_revision": committed["revision"],
+            "tasks": committed["tasks"],
+        }
+        self.save(transaction)
+        return transaction
+
+    def load(self) -> dict:
+        if not self.path.exists():
+            raise StoreError("no transaction is open")
+        try:
+            transaction = json.loads(self.path.read_text(encoding="utf-8"))
+        except json.JSONDecodeError as exc:
+            raise StoreError(f"malformed transaction: {exc.msg}") from exc
+        self._validate(transaction)
+        return transaction
+
+    def save(self, transaction: dict) -> None:
+        self._validate(transaction)
+        write_json_atomic(self.path, transaction)
+
+    def add(self, title: str) -> dict:
+        transaction = self.load()
+        task = add_task(transaction, title)
+        self.save(transaction)
+        return task
+
+    def complete(self, task_id: int) -> dict:
+        transaction = self.load()
+        task = complete_task(transaction, task_id)
+        self.save(transaction)
+        return task
+
+    def remove(self, task_id: int) -> dict:
+        transaction = self.load()
+        task = remove_task(transaction, task_id)
+        self.save(transaction)
+        return task
+
+    def commit(self) -> dict:
+        transaction = self.load()
+        committed = self.store.load()
+        if committed["revision"] != transaction["base_revision"]:
+            raise StoreError(
+                "transaction conflict: committed tasks changed after transaction begin"
+            )
+        published = {
+            "revision": committed["revision"] + 1,
+            "tasks": transaction["tasks"],
+        }
+        self.store.save(published)
+        self.path.unlink()
+        return published
+
+    def abort(self) -> None:
+        self.load()
+        self.path.unlink()
+
+    @staticmethod
+    def _validate(transaction: object) -> None:
+        if not isinstance(transaction, dict) or set(transaction) != {
+            "base_revision",
+            "tasks",
+        }:
+            raise StoreError("malformed transaction: expected base_revision and tasks")
+        try:
+            Store._validate(
+                {
+                    "revision": transaction["base_revision"],
+                    "tasks": transaction["tasks"],
+                }
+            )
+        except StoreError as exc:
+            raise StoreError(f"malformed transaction: {exc}") from exc
