--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -75,6 +75,62 @@ class TaskboxCliTest(unittest.TestCase):
             '{"revision": "bad"}\n',
         )
 
+    def test_transaction_snapshot_is_isolated_and_commits_once(self):
+        self.run_taskbox("add", "first")
+        begun = self.run_taskbox("transaction", "begin")
+        self.assertEqual(json.loads(begun.stdout), {"base_revision": 1})
+        self.run_taskbox("transaction", "add", "second")
+        self.run_taskbox("transaction", "complete", "1")
+
+        committed_list = self.run_taskbox("list", "--json")
+        transaction_list = self.run_taskbox("transaction", "list", "--json")
+        self.assertEqual(
+            json.loads(committed_list.stdout),
+            [{"id": 1, "title": "first", "completed": False}],
+        )
+        self.assertEqual(
+            json.loads(transaction_list.stdout),
+            [
+                {"id": 1, "title": "first", "completed": True},
+                {"id": 2, "title": "second", "completed": False},
+            ],
+        )
+
+        committed = self.run_taskbox("transaction", "commit")
+        self.assertEqual(committed.returncode, 0, committed.stderr)
+        self.assertEqual(json.loads(committed.stdout)["revision"], 2)
+
+    def test_transaction_abort_discards_staged_changes(self):
+        self.run_taskbox("add", "first")
+        self.run_taskbox("transaction", "begin")
+        self.run_taskbox("transaction", "remove", "1")
+        aborted = self.run_taskbox("transaction", "abort")
+        self.assertEqual(aborted.returncode, 0, aborted.stderr)
+        listed = self.run_taskbox("list", "--json")
+        self.assertEqual(
+            json.loads(listed.stdout),
+            [{"id": 1, "title": "first", "completed": False}],
+        )
+        restarted = self.run_taskbox("transaction", "begin")
+        self.assertEqual(restarted.returncode, 0, restarted.stderr)
+
+    def test_transaction_conflict_preserves_both_states(self):
+        self.run_taskbox("add", "first")
+        self.run_taskbox("transaction", "begin")
+        self.run_taskbox("transaction", "complete", "1")
+        self.run_taskbox("add", "outside")
+
+        conflict = self.run_taskbox("transaction", "commit")
+        self.assertEqual(conflict.returncode, 2)
+        self.assertIn("transaction conflict", conflict.stderr)
+        staged = self.run_taskbox("transaction", "list", "--json")
+        self.assertEqual(json.loads(staged.stdout)[0]["completed"], True)
+        committed = self.run_taskbox("list", "--json")
+        self.assertEqual(
+            [task["title"] for task in json.loads(committed.stdout)],
+            ["first", "outside"],
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
