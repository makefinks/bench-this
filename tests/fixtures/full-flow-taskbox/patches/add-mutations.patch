diff --git a/taskbox/store.py b/taskbox/store.py
index 0f289eb..052a6dd 100644
--- a/taskbox/store.py
+++ b/taskbox/store.py
@@ -37,3 +37,28 @@ class Store:
         state["revision"] += 1
         self.save(state)
         return task
+
+    def complete(self, task_id: int) -> dict:
+        state = self.load()
+        task = self._find(state, task_id)
+        if task["completed"]:
+            raise StoreError(f"task {task_id} is already complete")
+        task["completed"] = True
+        state["revision"] += 1
+        self.save(state)
+        return task
+
+    def remove(self, task_id: int) -> dict:
+        state = self.load()
+        task = self._find(state, task_id)
+        state["tasks"].remove(task)
+        state["revision"] += 1
+        self.save(state)
+        return task
+
+    @staticmethod
+    def _find(state: dict, task_id: int) -> dict:
+        for task in state["tasks"]:
+            if task["id"] == task_id:
+                return task
+        raise StoreError(f"task {task_id} does not exist")
diff --git a/tests/test_cli.py b/tests/test_cli.py
index aee9b86..b77d9ad 100644
--- a/tests/test_cli.py
