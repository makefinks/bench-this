@@ -46,6 +46,25 @@ class TaskboxCliTest(unittest.TestCase):
         self.assertEqual(result.returncode, 2)
         self.assertIn("must not be empty", result.stderr)
 
+    def test_complete_and_remove_tasks(self):
+        self.run_taskbox("add", "first")
+        self.run_taskbox("add", "second")
+        completed = self.run_taskbox("complete", "1")
+        removed = self.run_taskbox("remove", "2")
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertEqual(removed.returncode, 0, removed.stderr)
+
+        listed = self.run_taskbox("list", "--json")
+        self.assertEqual(
+            json.loads(listed.stdout),
+            [{"id": 1, "title": "first", "completed": True}],
+        )
+
+    def test_unknown_task_is_rejected(self):
+        result = self.run_taskbox("complete", "99")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("does not exist", result.stderr)
+
 
 if __name__ == "__main__":
     unittest.main()
